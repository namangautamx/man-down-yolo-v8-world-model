# ============================================================================
# yw_mandown - configuration template
#
# Copy this to config/config.yaml and edit. Every knob the pipeline uses
# comes from here -- nothing is hardcoded in the scripts.
# ============================================================================

model:
  name: "yolov8m-worldv2.pt"   # or yolov8s-worldv2.pt for a lighter/faster model
  device: null                 # null = auto (cuda if available), or "cuda", "cpu"
  image_size: 640

prompts:
  positive:
    - "a person lying on the floor"
    - "a person lying on the ground"
    - "a person sleeping"

  # Optional. YOLO-World gives one class per box (argmax + NMS), so these
  # cannot subtract from a positive score the way OWLv2's contrastive
  # negatives do. Instead: any positive box that overlaps a negative box
  # above negative_suppression.iou_threshold gets dropped. Leave empty to
  # disable this entirely (behaves like the original two scripts).
  negative:
    - "a person standing"
    - "a person walking"
    - "a mattress"
    - "a pile of bags"

  conf_threshold: 0.60          # positive detections below this are discarded
  negative_conf_floor: 0.25     # negatives only need to clear this to suppress

negative_suppression:
  enabled: true
  iou_threshold: 0.30           # positive/negative box overlap needed to suppress

processing:
  frame_skip: 2                 # run inference on every Nth frame; display/clips still get every frame

output:
  base_folder: "./output"       # crops/<source_id>/ and clips/<source_id>/ live under here
  save_crops: true
  save_clips: true
  clip_pre_seconds: 3.0         # seconds of rolling buffer written before the trigger frame
  clip_post_seconds: 3.0        # seconds kept recording after the last detection
  crop_min_interval_seconds: 1.0  # don't save a crop more than once per this many seconds

display:
  show_window: true             # only honoured when exactly one source is enabled
  window_name: "MAN-DOWN DETECTION"

logging:
  events_path: "./logs/events.jsonl"

# ----------------------------------------------------------------------------
# Sources. Add as many as you want; only ones with enabled: true are run.
# One source enabled -> runs in the main thread, live window allowed.
# More than one enabled -> runs threaded, live window forced off for all
# (see yw_mandown/cli.py docstring for why).
# ----------------------------------------------------------------------------
sources:
  - id: "sample_folder"
    type: "video_folder"          # video_file | video_folder | rtsp
    path: "/home/naman-gautam/Downloads/man_down_sample"
    enabled: true

  - id: "single_clip"
    type: "video_file"
    path: "/home/naman-gautam/Downloads/man down vdeios/1aaa01.mp4"
    enabled: false

  - id: "cam1"
    type: "rtsp"
    url: "rtsp://admin:Obama%40786@192.168.0.100/"
    reconnect_delay_seconds: 2.0
    enabled: false
